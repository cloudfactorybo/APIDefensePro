# Copia este archivo a .env y ajusta los valores.

# Postgres interno (equipos registrados + tokens)
POSTGRES_USER=defensepro
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=defensepro

# Redis (cache de respuestas SOAP). Opcional pero recomendado.
REDIS_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

# CORS: '*' o lista CSV de orígenes
ALLOWED_ORIGINS=*

# Llamadas SOAP simultáneas por DefensePro (bajar a 1-2 si el equipo se ve lento)
DEVICE_MAX_CONCURRENCY=4

# Puerto público HTTPS (Traefik)
PUBLIC_HTTPS_PORT=5687

# true apaga el Bearer token (sólo para desarrollo)
AUTH_DISABLED=
