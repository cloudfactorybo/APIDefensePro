# Copia este archivo a .env y ajusta los valores.

# Postgres interno (equipos registrados + tokens)
POSTGRES_USER=defensepro
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=defensepro

# Redis (cache de respuestas SOAP). Opcional pero recomendado.
REDIS_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text

# CORS: '*' o lista CSV de orígenes
ALLOWED_ORIGINS=*

# Protección del equipo: llamadas simultáneas (SOAP y SNMP) y pausa entre ellas
DEVICE_MAX_CONCURRENCY=1
DEVICE_MIN_CALL_GAP=100ms
# Sobre este % de CPU del equipo se omiten las consultas pesadas (0 = desactivado)
DEVICE_BUSY_CPU_PCT=85

# Puerto público HTTPS (Traefik)
PUBLIC_HTTPS_PORT=5687

# true apaga el Bearer token (sólo para desarrollo)
AUTH_DISABLED=
